<%- include('partials/header') %>

    <main id="main-content" class="interior-main">

        <section class="page-intro" aria-labelledby="page-title">
            <p class="eyebrow">PARTNER ORGANIZATIONS</p>

            <h1 id="page-title">
                <%= title %>
            </h1>

            <p class="page-description">
                Update the information for this organization.
            </p>
        </section>

        <section class="content-section">

            <form class="organization-form" action="/edit-organization/<%= organizationDetails.organization_id %>"
                method="POST">
                <div class="form-group">
                    <label for="name">Organization Name</label>

                    <input type="text" id="name" name="name" value="<%= organizationDetails.name %>" minlength="3"
                        maxlength="150" required>
                </div>

                <div class="form-group">
                    <label for="description">Description</label>

                    <textarea id="description" name="description" rows="5" maxlength="500"
                        required><%= organizationDetails.description %></textarea>
                </div>

                <div class="form-group">
                    <label for="contactEmail">Contact Email</label>

                    <input type="email" id="contactEmail" name="contactEmail"
                        value="<%= organizationDetails.contact_email %>" required>
                </div>

                <div class="form-group">
                    <label for="logoFilename">Logo Filename</label>

                    <input type="text" id="logoFilename" name="logoFilename"
                        value="<%= organizationDetails.logo_filename %>" maxlength="255" required>
                </div>

                <button class="btn btn-primary" type="submit">
                    Update Organization
                </button>

                <p>
                    <a href="/organization/<%= organizationDetails.organization_id %>">
                        Cancel and return to organization
                    </a>
                </p>
            </form>

        </section>

    </main>

    <%- include('partials/footer') %>