
<%- include('partials/header') %>

<main id="main-content" class="interior-main">

    <section class="page-intro" aria-labelledby="page-title">
        <p class="eyebrow">SERVICE OPPORTUNITIES</p>
        <h1 id="page-title"><%= title %></h1>
        <p class="page-description">
            Manage categories for <%= project.title %>.
        </p>
    </section>

    <section class="content-section">

        <form
            class="organization-form"
            action="/project/<%= project.project_id %>/categories"
            method="POST"
        >

            <h2>Project Categories</h2>

            <p>
                Select the categories for this project.
                Uncheck a category to remove it.
            </p>

            <fieldset>
                <legend>Select Categories</legend>

                <% if (categories.length === 0) { %>
                    <p>No categories are available.</p>
                <% } else { %>

                    <% categories.forEach(category => { %>

                        <% const assigned = assignedCategoryIds.includes(category.category_id); %>

                        <p>
                            <label for="category-<%= category.category_id %>">
                                <input
                                    type="checkbox"
                                    id="category-<%= category.category_id %>"
                                    name="categoryIds"
                                    value="<%= category.category_id %>"
                                    <%= assigned ? 'checked' : '' %>
                                >
                                <%= category.name %>
                            </label>
                        </p>

                    <% }); %>

                <% } %>
            </fieldset>

            <p>
                <button type="submit" class="btn btn-primary">
                    Save Category Assignments
                </button>
            </p>

            <p>
                <a href="/project/<%= project.project_id %>">
                    Back to Project Details
                </a>
            </p>

        </form>

    </section>

</main>

<%- include('partials/footer') %>
