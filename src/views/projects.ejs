
<%- include('partials/header') %>

<main id="main-content" class="interior-main">

    <section class="page-intro" aria-labelledby="page-title">
        <p class="eyebrow">SERVICE OPPORTUNITIES</p>
        <h1 id="page-title"><%= title %></h1>
        <p class="page-description">
            Explore upcoming service projects and the organizations
            making a difference in our communities.
        </p>
    </section>

    <section class="content-section" aria-label="Upcoming service projects">

        <% if (projects.length === 0) { %>
            <p>No upcoming service projects are available.</p>
        <% } else { %>

            <div class="project-grid">

                <% projects.forEach(project => { %>
                    <article class="project-card">

                        <p class="project-number">
                            <%= new Date(project.date).toLocaleDateString('en-US', {
                                year: 'numeric',
                                month: 'long',
                                day: 'numeric',
                                timeZone: 'UTC'
                            }) %>
                        </p>

                        <h2>
                            <a href="/project/<%= project.project_id %>">
                                <%= project.title %>
                            </a>
                        </h2>

                        <p>
                            Organization:
                            <a href="/organization/<%= project.organization_id %>">
                                <%= project.organization_name %>
                            </a>
                        </p>

                    </article>
                <% }); %>

            </div>

        <% } %>

    </section>

</main>

<%- include('partials/footer') %>
