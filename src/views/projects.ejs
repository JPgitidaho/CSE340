
<%- include('partials/header') %>

<main id="main-content" class="interior-main">

    <section class="page-intro" aria-labelledby="page-title">

        <p class="eyebrow">SERVICE OPPORTUNITIES</p>

        <h1 id="page-title"><%= title %></h1>

        <p class="page-description">
            Explore upcoming service projects and the organizations
            making a difference in our communities.
        </p>

        <p>
            <a class="btn btn-primary" href="/new-project">
                Add a New Service Project
            </a>
        </p>

    </section>

    <section class="content-section" aria-labelledby="upcoming-heading">

        <h2 id="upcoming-heading" class="section-title">
            Upcoming Service Projects
        </h2>

        <% if (projects.length === 0) { %>

            <p>No upcoming service projects are available.</p>

        <% } else { %>

            <div class="project-grid">

                <% projects.forEach(project => { %>

                    <article class="project-card">

                        <p class="project-number">
                            <%= new Date(project.date).toLocaleDateString('en-US', {
                                year: 'numeric',
                                month: 'long',
                                day: 'numeric',
                                timeZone: 'UTC'
                            }) %>
                        </p>

                        <h3>
                            <a href="/project/<%= project.project_id %>">
                                <%= project.title %>
                            </a>
                        </h3>

                        <p>
                            Organization:
                            <a href="/organization/<%= project.organization_id %>">
                                <%= project.organization_name %>
                            </a>
                        </p>

                        <p>
                            <a href="/edit-project/<%= project.project_id %>">
                                Edit Project
                            </a>
                        </p>

                        <p>
                            <a href="/project/<%= project.project_id %>/categories">
                                Assign Categories
                            </a>
                        </p>

                    </article>

                <% }); %>

            </div>

        <% } %>

    </section>

    <section class="content-section" aria-labelledby="all-projects-heading">

        <h2 id="all-projects-heading" class="section-title">
            Other Service Projects
        </h2>

        <% if (otherProjects.length === 0) { %>

            <p>All registered projects are listed above.</p>

        <% } else { %>

            <div class="project-grid">

                <% otherProjects.forEach(project => { %>

                    <article class="project-card">

                        <p class="project-number">
                            <%= new Date(project.date).toLocaleDateString('en-US', {
                                year: 'numeric',
                                month: 'long',
                                day: 'numeric',
                                timeZone: 'UTC'
                            }) %>
                        </p>

                        <h3>
                            <a href="/project/<%= project.project_id %>">
                                <%= project.title %>
                            </a>
                        </h3>

                        <p>
                            Organization:
                            <a href="/organization/<%= project.organization_id %>">
                                <%= project.organization_name %>
                            </a>
                        </p>

                        <p>
                            <a href="/edit-project/<%= project.project_id %>">
                                Edit Project
                            </a>
                        </p>

                        <p>
                            <a href="/project/<%= project.project_id %>/categories">
                                Assign Categories
                            </a>
                        </p>

                    </article>

                <% }); %>

            </div>

        <% } %>

    </section>

</main>

<%- include('partials/footer') %>
