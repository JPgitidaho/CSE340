<%- include('partials/header') %>

    <main id="main-content" class="interior-main">

        <section class="page-intro" aria-labelledby="page-title">
            <p class="eyebrow">SERVICE OPPORTUNITIES</p>
            <h1 id="page-title">
                <%= title %>
            </h1>
            <p class="page-description">
                Explore meaningful opportunities to contribute
                to stronger communities.
            </p>
        </section>

        <section class="content-section" aria-labelledby="projects-heading">
            <h2 id="projects-heading" class="section-title">
                Upcoming Service Projects
            </h2>

            <div class="project-grid">

                <% projects.forEach((project, index)=> { %>

                    <article class="project-card">
                        <span class="project-number">
                            PROJECT <%= String(index + 1).padStart(2, '0' ) %>
                        </span>

                        <h3 class="project-heading">
                            <span class="project-date">
                                <%= new Date(project.date).toLocaleDateString('en-US', { month: 'short' , day: 'numeric'
                                    , year: 'numeric' , timeZone: 'UTC' }) %>:
                            </span>

                            <span class="project-title">
                                <%= project.title %>
                            </span>

                            <span class="project-organization">
                                (<%= project.organization_name %>)
                            </span>
                        </h3>

                        <p class="project-description">
                            <%= project.description %>
                        </p>

                        <p class="project-location">
                            <strong>Location:</strong>
                            <%= project.location %>
                        </p>
                    </article>

                    <% }); %>

            </div>
        </section>

    </main>

    <%- include('partials/footer') %>