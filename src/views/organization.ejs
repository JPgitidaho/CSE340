
<%- include('partials/header') %>

<section class="content-section" aria-labelledby="organization-projects">
    <h2 id="organization-projects" class="section-title">
        Organization Projects
    </h2>

    <% if (projects.length === 0) { %>
        <p>No projects are available for this organization.</p>
    <% } else { %>
        <div class="project-grid">
            <% projects.forEach(project => { %>
                <article class="project-card">
                    <h3>
                        <a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                    </h3>

                    <p>
                        <strong>Date:</strong>
                        <%= new Date(project.date).toLocaleDateString('en-US', {
                            year: 'numeric',
                            month: 'long',
                            day: 'numeric',
                            timeZone: 'UTC'
                        }) %>
                    </p>

                    <p>
                        <strong>Location:</strong>
                        <%= project.location %>
                    </p>
                </article>
            <% }); %>
        </div>
    <% } %>
</section>


<main id="main-content" class="interior-main">

    <section class="page-intro" aria-labelledby="page-title">
        <p class="eyebrow">PARTNER ORGANIZATION</p>
        <h1 id="page-title"><%= organization.name %></h1>
        <p class="page-description">
            <%= organization.description %>
        </p>
    </section>

    <section class="content-section" aria-label="Organization information">

        <article class="organization-card">

            <img
                src="/images/<%= organization.logo_filename %>"
                alt="<%= organization.name %> logo"
                width="120"
                height="120"
            >

            <h2>Contact Information</h2>

            <p>
                <strong>Email:</strong>
                <a href="mailto:<%= organization.contact_email %>">
                    <%= organization.contact_email %>
                </a>
            </p>

            <p>
                <a href="/organizations">Back to Organizations</a>
            </p>

        </article>

    </section>

</main>

<%- include('partials/footer') %>
