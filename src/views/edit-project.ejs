
<%- include('partials/header') %>

<main id="main-content" class="interior-main">

    <section class="page-intro" aria-labelledby="page-title">
        <p class="eyebrow">SERVICE OPPORTUNITIES</p>

        <h1 id="page-title"><%= title %></h1>

        <p class="page-description">
            Update the information for this service project.
        </p>
    </section>

    <section class="content-section">

        <form
            class="organization-form"
            action="/edit-project/<%= project.project_id %>"
            method="POST"
        >
            <div class="form-group">
                <label for="title">Project Title</label>

                <input
                    type="text"
                    id="title"
                    name="title"
                    value="<%= project.title %>"
                    maxlength="150"
                    required
                >
            </div>

            <div class="form-group">
                <label for="description">Description</label>

                <textarea
                    id="description"
                    name="description"
                    rows="5"
                    maxlength="1000"
                    required
                ><%= project.description %></textarea>
            </div>

            <div class="form-group">
                <label for="location">Location</label>

                <input
                    type="text"
                    id="location"
                    name="location"
                    value="<%= project.location %>"
                    maxlength="200"
                    required
                >
            </div>

            <div class="form-group">
                <label for="date">Date</label>

                <input
                    type="date"
                    id="date"
                    name="date"
                    value="<%= new Date(project.date).toISOString().slice(0, 10) %>"
                    required
                >
            </div>

            <div class="form-group">
                <label for="organizationId">Organization</label>

                <select
                    id="organizationId"
                    name="organizationId"
                    required
                >
                    <% organizations.forEach(organization => { %>

                        <option
                            value="<%= organization.organization_id %>"
                            <%= Number(project.organization_id) === Number(organization.organization_id) ? 'selected' : '' %>
                        >
                            <%= organization.name %>
                        </option>

                    <% }); %>
                </select>
            </div>

            <button class="btn btn-primary" type="submit">
                Update Project
            </button>

            <p>
                <a href="/project/<%= project.project_id %>">
                    Cancel and Return to Project
                </a>
            </p>

        </form>

    </section>

</main>

<%- include('partials/footer') %>
