<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description"
        content="Discover community service organizations, projects and opportunities through CSE 340 Service Network.">
    <meta name="theme-color" content="#142f45">
    <title>
        <%= title %> | CSE 340 Service Network
    </title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/flash.css">
</head>

<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header">
        <div class="header-container">

            <a class="site-brand" href="/" aria-label="CSE 340 Service Network - Home">
                <span class="brand-symbol" aria-hidden="true">
                    <span></span><span></span><span></span><span></span>
                </span>
                <span class="brand-name">
                    <strong>CSE 340</strong>
                    <span>Service Network</span>
                </span>
            </a>

            <nav class="main-nav" aria-label="Main navigation">
                <ul>
                    <li>
                        <a href="/" <% if (title==='Home' ) { %>aria-current="page"<% } %>>
                                Home
                        </a>
                    </li>
                    <li>
                        <a href="/organizations" <% if (title==='Our Partner Organizations' ) { %>aria-current="page"<%
                                } %>>
                                Organizations
                        </a>
                    </li>
                    <li>
                        <a href="/projects" <% if (title==='Service Projects' ) { %>aria-current="page"<% } %>>
                                Projects
                        </a>
                    </li>
                    <li>
                        <a href="/categories" <% if (title==='Service Project Categories' ) { %>aria-current="page"<% }
                                %>>
                                Categories
                        </a>
                    </li>

                    <% if (isLoggedIn) { %>
                        <li>
                            <a href="/logout">Log Out</a>
                        </li>
                        <% } else { %>
                            <li>
                                <a href="/register" <% if (title==='Register' ) { %>aria-current="page"<% } %>>
                                        Register
                                </a>
                            </li>
                            <li>
                                <a href="/login" <% if (title==='Login' ) { %>aria-current="page"<% } %>>
                                        Log In
                                </a>
                            </li>
                            <% } %>


                </ul>
            </nav>

        </div>
    </header>

    <% const flashMessages=flash(); %>

        <% if (Object.values(flashMessages).some(items=> items.length > 0)) { %>
            <div class="flash-messages" aria-live="polite">
                <% Object.keys(flashMessages).forEach(type=> { %>
                    <% flashMessages[type].forEach(msg=> { %>
                        <div class="alert <%= type %>" role="status">
                            <%= msg %>
                        </div>
                        <% }); %>
                            <% }); %>
            </div>
            <% } %>