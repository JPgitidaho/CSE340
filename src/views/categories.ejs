
<%- include('partials/header') %>

<main id="main-content" class="interior-main">

    <section class="page-intro" aria-labelledby="page-title">
        <p class="eyebrow">AREAS OF ACTION</p>
        <h1 id="page-title"><%= title %></h1>
        <p class="page-description">
            Discover the different areas where community
            service can make a meaningful difference.
        </p>
    </section>

    <section class="content-section" aria-labelledby="categories-heading">
        <h2 id="categories-heading" class="section-title">
            Explore Service Categories
        </h2>

        <div class="service-category-grid">

            <% categories.forEach((category, index) => { %>
                <article class="service-category-card">
                    <span class="category-number">
                        <%= String(index + 1).padStart(2, '0') %>
                    </span>

                    <h3><%= category.name %></h3>
                </article>
            <% }); %>

        </div>
    </section>

</main>

<%- include('partials/footer') %>
