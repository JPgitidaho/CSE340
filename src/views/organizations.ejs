
<%- include('partials/header') %>

<main id="main-content" class="interior-main">

    <section class="page-intro" aria-labelledby="page-title">
        <p class="eyebrow">OUR NETWORK</p>
        <h1 id="page-title"><%= title %></h1>
        <p class="page-description">
            Meet the organizations contributing to stronger,
            more connected communities.
        </p>
    </section>

    <section class="content-section" aria-label="Partner organizations">
        <div class="organization-grid">

            <article class="organization-card">
                <img src="/images/brightfuture-logo.png"
                     alt="BrightFuture Builders logo"
                     width="120" height="120">
                <h2>BrightFuture Builders</h2>
                <a href="mailto:info@brightfuture.org">
                    info@brightfuture.org
                </a>
            </article>

            <article class="organization-card">
                <img src="/images/greenharvest-logo.png"
                     alt="GreenHarvest Growers logo"
                     width="120" height="120">
                <h2>GreenHarvest Growers</h2>
                <a href="mailto:contact@greenharvest.org">
                    contact@greenharvest.org
                </a>
            </article>

            <article class="organization-card">
                <img src="/images/unityserve-logo.png"
                     alt="UnityServe Volunteers logo"
                     width="120" height="120">
                <h2>UnityServe Volunteers</h2>
                <a href="mailto:hello@unityserve.org">
                    hello@unityserve.org
                </a>
            </article>

        </div>
    </section>

</main>

<%- include('partials/footer') %>
