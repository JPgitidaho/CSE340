
<%- include('partials/header') %>

<main id="main-content" class="interior-main">

    <section class="page-intro" aria-labelledby="page-title">
        <p class="eyebrow">OUR NETWORK</p>

        <h1 id="page-title"><%= title %></h1>

        <p class="page-description">
            Meet the organizations contributing to stronger,
            more connected communities.
        </p>

        <% if (user && user.role_name === 'admin') { %>
            <p>
                <a class="btn btn-primary" href="/new-organization">
                    Add New Organization
                </a>
            </p>
        <% } %>
    </section>

    <section class="content-section" aria-label="Partner organizations">

        <% if (organizations.length === 0) { %>

            <p>No organizations are available.</p>

        <% } else { %>

            <div class="organization-grid">

                <% organizations.forEach(organization => { %>

                    <article class="organization-card">

                        <% if (organization.logo_filename) { %>
                            <img
                                src="/images/<%= organization.logo_filename %>"
                                alt="<%= organization.name %> logo"
                                width="120"
                                height="120"
                                loading="lazy"
                            >
                        <% } %>

                        <h2>
                            <a href="/organization/<%= organization.organization_id %>">
                                <%= organization.name %>
                            </a>
                        </h2>

                        <% if (organization.description) { %>
                            <p><%= organization.description %></p>
                        <% } %>

                        <% if (organization.contact_email) { %>
                            <p>
                                <a href="mailto:<%= organization.contact_email %>">
                                    <%= organization.contact_email %>
                                </a>
                            </p>
                        <% } %>

                        <% if (user && user.role_name === 'admin') { %>
                            <p>
                                <a href="/edit-organization/<%= organization.organization_id %>">
                                    Edit Organization
                                </a>
                            </p>
                        <% } %>

                    </article>

                <% }); %>

            </div>

        <% } %>

    </section>

</main>

<%- include('partials/footer') %>
